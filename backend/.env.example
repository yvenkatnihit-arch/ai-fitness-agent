# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored. Never commit real keys.

# --- App ---
APP_ENV=development
# Comma-separated list of frontend URLs allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# Kruthi's choice (D-015): gemini-2.5-flash for both tiers. It is deprecated and Google
# routes it to gemini-3.5-flash-lite on 2026-12-01. Stable alternatives:
#   GEMINI_SMALL_MODEL=gemini-3.5-flash-lite   GEMINI_MID_MODEL=gemini-3.6-flash
# Small = used by default. Mid = plans and adjustments only.
GEMINI_SMALL_MODEL=gemini-2.5-flash
GEMINI_MID_MODEL=gemini-2.5-flash

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
# Publishable key (called "anon" in older projects). Safe for the browser.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (called "service_role" in older projects). Backend only; bypasses RLS.
SUPABASE_SECRET_KEY=
# Postgres connection string (Project Settings -> Database). Confirmed in Phase 2 (D-012).
DATABASE_URL=

# --- LangSmith (optional during development) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-fitness-agent
