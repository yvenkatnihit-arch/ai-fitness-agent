# Copy to `.env` and fill in. Everything here is PUBLIC: Vite puts VITE_* values
# into the JavaScript that runs in the browser. Never put secrets in this file.

# FastAPI backend URL.
VITE_API_URL=http://localhost:8000

# Supabase project URL and PUBLISHABLE key (safe in the browser; used for login only, D-032).
# Never put the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
